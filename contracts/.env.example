# Copy to contracts/.env (gitignored). Never commit real values.

# Deployer key for forge scripts (Deploy, Release, Smoke). Fund it from https://faucet.circle.com on testnet.
DEPLOYER_PK=
# ReleaseRegistry owner. Defaults to the deployer; must be a multisig on mainnet.
RELEASE_OWNER=
# Notes file for script/Release.s.sol, e.g. releases/vault-v2.md
RELEASE_NOTES=
