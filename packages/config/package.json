{
  "name": "@symbolon/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared environment for the web app and the worker: chain, database, Circle, and the Steward model",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@symbolon/chain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "7.0.2"
  }
}
