{
  "name": "@symbolon/db",
  "version": "0.1.0",
  "private": true,
  "description": "Symbolon's Postgres schema (offchain cache and records; chain is the source of truth for money)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
