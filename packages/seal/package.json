{
  "name": "@symbolon/seal",
  "version": "0.1.0",
  "private": true,
  "description": "Symbolon's signed types: EIP-712, canonical invoice documents, fingerprints and signature checks",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "vectors": "tsx scripts/vectors.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "viem": "2.56.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "ethers": "6.15.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
