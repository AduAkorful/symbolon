# Copy to .env (gitignored) for the app / scheduled job. Never commit real values.

# Arc chain the app runs against (5042002 testnet, 5042 mainnet). Addresses come from contracts/deployments/<id>.json.
CHAIN_ID=5042002
# Optional RPC override; defaults to the docs.arc.io endpoints with fallback.
ARC_RPC_URL=

# Postgres (any host). Migrations: @symbolon/db migrateDb(DATABASE_URL).
DATABASE_URL=

# Claude, for invoice extraction and decision explanations (packages/steward). Never on the payment path.
ANTHROPIC_API_KEY=

# Circle: developer-controlled wallet for each business's Steward key, and Compliance Engine screening.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# The app makes one Steward wallet per business when the API key and entity secret above are both set (idempotent by business id).
# Optional: put them all in an existing wallet set; unset, the app creates one called "Symbolon Stewards".
CIRCLE_WALLET_SET_ID=
# One Steward wallet for the standalone testnet runs of packages/steward
STEWARD_WALLET_ID=
STEWARD_WALLET_ADDRESS=

# The app (app/). Sign-in messages and every POST are pinned to this origin.
# Required in production (https); development defaults to http://localhost:3000.
APP_ORIGIN=
# Required to start/show vendor callback codes. Generate 32 random bytes and keep this stable across app instances.
# Codes are AES-256-GCM encrypted at rest for the vendor view; a separate HMAC is used to check member-submitted guesses.
VERIFICATION_CODE_KEY=
# Privy: the only way in for people (email or a wallet they already use). From the Privy dashboard: create an app, allow the origin
# in APP_ORIGIN, enable the email and wallet login methods and embedded wallets for users without a wallet, and turn the rest off.
# With neither set nobody can sign in (the sign-in page says so); production refuses to start without them.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: the app's verification key from the dashboard, so tokens are checked without a network call
PRIVY_JWT_VERIFICATION_KEY=
# Optional: a secret for the scheduler that calls POST /api/cron/sync (Authorization: Bearer <secret>). Unset = the route is off.
CRON_SECRET=
