{
  "name": "@symbolon/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Long-running indexer and Steward. The Next app reads the Postgres mirror and does not scan Arc.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@symbolon/chain": "workspace:*",
    "@symbolon/config": "workspace:*",
    "@symbolon/core": "workspace:*",
    "@symbolon/db": "workspace:*",
    "@symbolon/steward": "workspace:*",
    "drizzle-orm": "0.45.3",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
